# VS Code "2026 Light" counterpart to vscode-2026-dark.
# UI colors: white bg / black fg, matching VS Code Light+.
# ANSI palette: VS Code Light+'s built-in terminal defaults where the dark
# theme's slot is unreadable on white (black, white/gray, yellow); red, blue,
# magenta, cyan are unchanged from vscode-2026-dark since they already read
# fine on a white background.

foreground = #000000
background = #FFFFFF

cursor-color = #000000
cursor-text = #FFFFFF

selection-background = #ADD6FF
selection-foreground = #000000

palette = 0=#000000
palette = 1=#cd3131
palette = 2=#00bc00
palette = 3=#949800
palette = 4=#0451a5
palette = 5=#bc05bc
palette = 6=#0598bc
palette = 7=#555555
palette = 8=#666666
palette = 9=#cd3131
palette = 10=#14ce14
palette = 11=#b5ba00
palette = 12=#0451a5
palette = 13=#bc05bc
palette = 14=#0598bc
palette = 15=#a5a5a5

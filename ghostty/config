# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 16
font-codepoint-map = U+27A4=Menlo
# Regular weight: font-style = Bold and font-thicken = true made everything heavy.
font-thicken = false
bold-is-bright = false
adjust-cell-height = 8%
alpha-blending = linear-corrected

# Window
window-width = 120
window-height = 120
window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
window-colorspace = srgb
window-theme = system
macos-titlebar-style = tabs
background-opacity = 1
background-blur = 10
confirm-close-surface = false
# Ghostty counts bytes here, not lines. ~100MB covers wezterm's 90k lines.
scrollback-limit = 100000000
# Defaults are precision:1,discrete:3. discrete = mouse wheel lines per notch, precision = trackpad.
mouse-scroll-multiplier = precision:0.5,discrete:1

# Theme (toggle-theme.sh swaps boltz-dark and boltz-light; the theme sets the background)
theme = boltz-light

# Shaders
# custom-shader = crt-light.glsl
# custom-shader-animation = false

# Keybindings
macos-option-as-alt = true

# Splits (ctrl+opt)
keybind = ctrl+opt+s=new_split:right
keybind = ctrl+opt+v=new_split:down
keybind = ctrl+opt+w=close_surface

# Pane navigation (ctrl+opt+arrows)
keybind = ctrl+opt+left=goto_split:left
keybind = ctrl+opt+right=goto_split:right
keybind = ctrl+opt+up=goto_split:up
keybind = ctrl+opt+down=goto_split:down

# Tab navigation (cmd+opt+arrows, matches Chrome/Arc)
keybind = cmd+opt+left=previous_tab
keybind = cmd+opt+right=next_tab
keybind = cmd+t=new_tab

# Newline instead of submit in Claude Code
keybind = shift+enter=text:\x1b\r

# Quick Terminal
keybind = global:super+grave_accent=toggle_quick_terminal
quick-terminal-animation-duration = 0

# Misc stuff that I stole from GitHub
cursor-style = block
cursor-style-blink = false
link-url = true
window-inherit-working-directory = true
window-inherit-font-size = true
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true
macos-titlebar-proxy-icon = hidden
unfocused-split-opacity = 0.9
shell-integration-features = no-cursor,ssh-terminfo
config-file = ?tode/keybinds.ghostty

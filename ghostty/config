# Tab bar — blocky and minimal
window-theme = system
macos-option-as-alt = true


# Font Shtuff
font-family = "JetBrainsMono Nerd Font"
font-size = 19
font-thicken = true
adjust-cell-height = 12%

window-padding-x = 16
window-padding-y = 12
window-padding-balance = true
window-padding-color = background
window-colorspace = display-p3
background-opacity = 0.97
background-blur = 24

# Theme (toggle-theme.sh rewrites this line)
theme = Gruvbox Dark

# Shaders 
custom-shader = crt.glsl
custom-shader-animation = false

# Split keybindings (ctrl+opt)
keybind = ctrl+opt+s=new_split:right
keybind = ctrl+opt+v=new_split:down
keybind = ctrl+opt+w=close_surface

# Pane navigation (ctrl+opt+arrows)
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:top
keybind = ctrl+shift+down=goto_split:bottom


# Tab navigation (cmd+opt+arrows, matches Chrome/Arc)
keybind = cmd+opt+left=previous_tab
keybind = cmd+opt+right=next_tab

# New tab
keybind = cmd+t=new_tab

# Quick Terminal
keybind = global:super+grave_accent=toggle_quick_terminal

# Misc stuff that I stole from GitHub
quick-terminal-animation-duration = 0
keybind = global:super+grave_accent=toggle_quick_terminal
cursor-style = block
cursor-style-blink = false
link-url = true
window-inherit-working-directory = true
window-inherit-font-size = true
clipboard-trim-trailing-spaces = true
mouse-hide-while-typing = true
macos-titlebar-proxy-icon = hidden
unfocused-split-opacity = 0.9
shell-integration-features = no-cursor,ssh-terminfo



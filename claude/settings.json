{
  "env": {
    "DISABLE_INSTALLATION_CHECKS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(mmdc:*)",
      "Bash(rsvg-convert:*)",
      "Bash(magick:*)",
      "Bash(wezterm cli:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/prompt-reminder.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$(jq -r '.tool_input.file_path // empty')\"; case \"$f\" in *.go) command -v gofmt >/dev/null 2>&1 && gofmt -w \"$f\" ;; *.ts|*.tsx|*.js|*.jsx) command -v prettier >/dev/null 2>&1 && npx prettier --write \"$f\" 2>/dev/null; command -v eslint >/dev/null 2>&1 && npx eslint --fix \"$f\" 2>/dev/null ;; *.py) command -v ruff >/dev/null 2>&1 && ruff format --quiet \"$f\" ;; esac || true",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-approved.sh",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "EnterPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/plan-rules.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/coding-conventions.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/no-comments.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'BLOCK: Do not call MCP tools directly in the main conversation. Spawn a subagent (model: haiku) to run this MCP call and return a concise summary. This preserves context window tokens.' && exit 2"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/learn-log.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-start.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "outputStyle": "Dry",
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-sonnet-5": {},
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-4-8": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "theme": "custom:vscode-2026-dark",
  "editorMode": "vim",
  "verbose": false
}

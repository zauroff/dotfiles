{
  "github.copilot.nextEditSuggestions.enabled": true,
  "files.eol": "\n",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "editor.fontFamily": "'JetBrains Mono', 'Dank Mono', monospace",
  "editor.fontSize": 18,
  "editor.minimap.enabled": false,
  "python.defaultInterpreterPath": "/usr/bin/python3",
  "telemetry.enableTelemetry": false,
  "extensions.ignoreRecommendations": true,
  "remote.SSH.useLocalServer": false,
  "remote.SSH.configFile": "~/.ssh/config",
  "remote.SSH.showLoginTerminal": true,
  "remote.SSH.useExecServer": false,
  "remote.SSH.useCurlAndWgetConfigurationFiles": true,
  "editor.renderWhitespace": "boundary",
  "terminal.integrated.initialHint": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "window.density.editorTabHeight": "compact",
  "workbench.tree.indent": 12,
  "editor.overviewRulerLanes": 0,
  "editor.hideCursorInOverviewRuler": true,
  "editor.overviewRulerBorder": false,
  "editor.scrollbar.verticalScrollbarSize": 6,
  "editor.scrollbar.horizontalScrollbarSize": 6,
  "workbench.navigationControl.enabled": false,
  "chat.commandCenter.enabled": false,
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "window.nativeFullScreen": false,
  "git.autofetch": true,
  "python.analysis.typeCheckingMode": "standard",
  "git.confirmSync": false,
  "autoHide.autoHideAuxiliaryBar": false,
  "security.promptForRemoteFileProtocolHandling": false,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font Mono', 'JetBrains Mono', monospace",
  "terminal.integrated.fontSize": 16,
  "workbench.startupEditor": "none",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
  },
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  // nvim's cursorline: fill the line and the gutter, not just the text column
  "editor.renderLineHighlight": "all",
  "workbench.colorCustomizations": {
    "editorGhostText.border": "#ff000050",
    "editorGhostText.foreground": "#ff000050",

    "scrollbarSlider.background": "#c494df60",
    "scrollbarSlider.hoverBackground": "#c494df90",
    "scrollbarSlider.activeBackground": "#c6a0f6",
    "editorOverviewRuler.border": "#00000000",

    // gruvbox ships lineHighlightBackground at 60 alpha over a near-identical
    // shade, so it blends to nothing. Full opacity on bg1, plus bg2 as a border
    // to give the band an edge. Scoped per theme so toggle-theme.sh keeps both.
    "[Gruvbox Dark Soft]": {
      "editor.lineHighlightBackground": "#3c3836",
      "editor.lineHighlightBorder": "#504945",
      "editorLineNumber.activeForeground": "#fabd2f", // CursorLineNr
      "list.activeSelectionBackground": "#3c3836",
      "list.inactiveSelectionBackground": "#3c3836",
    },
    "[Gruvbox Light Soft]": {
      "editor.lineHighlightBackground": "#ebdbb2",
      "editor.lineHighlightBorder": "#d5c4a1",
      "editorLineNumber.activeForeground": "#b57614",
      "list.activeSelectionBackground": "#ebdbb2",
      "list.inactiveSelectionBackground": "#ebdbb2",
    },
  },
  "task.allowAutomaticTasks": "on",
  "go.inlayHints.assignVariableTypes": true,
  "go.inlayHints.compositeLiteralTypes": true,
  "go.inlayHints.constantValues": true,
  "go.lintTool": "golangci-lint",
  "go.lintOnSave": "workspace",
  "editor.formatOnSave": true,
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
    },
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "chat.agent.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "git.blame.editorDecoration.enabled": true,
  "git.blame.ignoreWhitespace": true,
  "github.showAvatar": false,
  "git.blame.editorDecoration.disableHover": false,
  "chat.plugins.enabled": true,
  "chat.plugins.marketplace": [],
  "workbench.colorTheme": "Mac 90's Theme",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "gitlens.showWhatsNewAfterUpgrades": false,
  "gitlens.plusFeatures.enabled": false,
  "terminal.integrated.tabs.enabled": false,
  "workbench.activityBar.location": "bottom",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.focusView": true,

  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,
  "editor.cursorSurroundingLines": 8,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.scrollPredominantAxis": true,
  "editor.experimental.asyncTokenization": true,
  "editor.occurrencesHighlightDelay": 250,
  "editor.hover.delay": 400,
  "editor.experimentalGpuAcceleration": "on",
  "gitlens.currentLine.enabled": false,
  "gitlens.codeLens.enabled": false,
  "gitlens.statusBar.enabled": false,

  // --- stands in for nvim plugins that extras.vscode now disables ---
  "editor.stickyScroll.enabled": true, // nvim-treesitter-context
  "editor.linkedEditing": true, // nvim-ts-autotag
  "editor.guides.bracketPairs": "active", // rainbow-delimiters.nvim
  "editor.bracketPairColorization.enabled": true,
  "window.restoreWindows": "all", // persistence.nvim
  "editor.gotoLocation.multipleReferences": "gotoAndPeek",
  "workbench.browser.showInTitleBar": false,
  "window.customTitleBarVisibility": "never",
  "git.blame.statusBarItem.enabled": false,
  "chat.fontSize": 18,
  "chat.disableAIFeatures": true, // trouble.nvim
}
